# ==============================================================================
# Solvear CPaaS Enterprise Platform - Production Environment Configuration
# ==============================================================================

# Public Host / Frontend URL
NEXT_PUBLIC_APP_URL=https://solvear.in
NEXT_PUBLIC_API_URL=https://solvear.in
NEXT_PUBLIC_APP_NAME="Solvear CPaaS Platform"

# API & Server Configuration
PORT=4000
NODE_ENV=production
API_PREFIX=api

# Primary PostgreSQL Database
DATABASE_URL="postgresql://solvear_admin:solvear_secure_password_2026@postgres:5432/solvear_cpaas?schema=public&sslmode=prefer"
POSTGRES_DB=solvear_cpaas
POSTGRES_USER=solvear_admin
POSTGRES_PASSWORD=solvear_secure_password_2026

# Redis 7 Cache & Pub/Sub
REDIS_URL="redis://:redis_secure_pass_2026@redis:6379"
REDIS_PASSWORD=redis_secure_pass_2026

# JWT Authentication
JWT_SECRET="solvear_jwt_super_secret_key_2026_enterprise"
JWT_EXPIRATION="1d"
JWT_REFRESH_SECRET="solvear_jwt_refresh_token_key_2026_enterprise"
JWT_REFRESH_EXPIRATION="7d"

# Meta WhatsApp Business Cloud API
META_WABA_APP_ID=
META_WABA_APP_SECRET=
META_SYSTEM_ACCESS_TOKEN=

# AI Sidecar
OPENAI_API_KEY=
GEMINI_API_KEY=

# Payment Gateway (Razorpay / PhonePe)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
