# ==============================================================================
# CPaaS Enterprise Platform - Environment Configuration Example
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="CloudSMS CPaaS Enterprise"

# Database Configuration (PostgreSQL / SQLite for local development)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cpaas_db?schema=public"
# For SQLite testing: DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_SECRET="super_secret_jwt_cpaas_enterprise_access_key_2026_x89f!"
JWT_EXPIRATION="1d"
JWT_REFRESH_SECRET="super_secret_jwt_cpaas_refresh_token_key_2026_y77z@"
JWT_REFRESH_EXPIRATION="7d"

# Rate Limiting & Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# CORS Whitelist (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000"

# Payment Gateway - Razorpay Integration
RAZORPAY_KEY_ID="rzp_test_samplekey123456"
RAZORPAY_KEY_SECRET="sample_razorpay_secret_key_892318"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_cpaas_2026"

# Payment Gateway - PhonePe Integration
PHONEPE_MERCHANT_ID="MERCHANTUAT"
PHONEPE_SALT_KEY="099eb0cd-02cf-4e2a-8aca-3e6c6aff0399"
PHONEPE_SALT_INDEX="1"
PHONEPE_ENV="UAT"

# Pricing & Conversion (1 SMS Credit = INR ₹0.12)
SMS_CREDIT_RATE_INR=0.12

# DLT / Telemarketer Gateway Configuration (Simulated / Telco APIs)
DLT_PE_ID_PREFIX="17011"
SMS_GATEWAY_PROVIDER="AIRTEL_JIO_ROUTER"
