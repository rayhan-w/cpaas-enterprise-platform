# -------------------------------------------------------------
# Production Dockerfile for AI Bot Sidecar (FastAPI & Node Webhook Engine)
# -------------------------------------------------------------

FROM node:20-alpine AS runner
WORKDIR /app
RUN apk add --no-cache python3 py3-pip libc6-compat
ENV NODE_ENV=production
ENV PORT=5000

COPY apps/chatbot/package*.json ./
RUN npm ci --only=production

COPY apps/chatbot/ .

EXPOSE 5000

CMD ["node", "server.js"]
