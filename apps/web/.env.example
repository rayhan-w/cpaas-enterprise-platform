# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database Connection URL (Prisma ORM)
# Pooled or Direct PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres_secure_password_2026@localhost:5432/trackops_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres_secure_password_2026@localhost:5432/trackops_db?schema=public"

# Production JWT Secret for Authenticated User and Admin Sessions
JWT_SECRET="trackops_enterprise_production_secret_key_2026_x89f_vault"

# Anonymization Salt for Hash-Based Visitor Telemetry (SHA-256)
IP_SALT="trackops_telemetry_salt_production_2026"

# Node Environment
NODE_ENV="production"
PORT=3000
