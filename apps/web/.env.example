# Environment Variables for Nurtura Bangladesh Multi-Category E-Commerce Platform

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (PostgreSQL) Connection Strings
# Replace [YOUR-PASSWORD] and [PROJECT-REF] with your Supabase credentials
# Direct connection for migrations, pooled connection (port 6543) for runtime queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Admin Authentication JWT Secret
JWT_SECRET="nurtura-bangladesh-super-secure-jwt-secret-key-2026-production"

# SSLCommerz Payment Gateway Configuration (Sandbox / Test Mode)
SSLCOMMERZ_STORE_ID="testbox"
SSLCOMMERZ_STORE_PASSWORD="qwerty"
SSLCOMMERZ_IS_LIVE="false"

# Store Notification Numbers (Fallback defaults)
NEXT_PUBLIC_BKASH_MERCHANT_NUMBER="01700-000000"
NEXT_PUBLIC_NAGAD_MERCHANT_NUMBER="01800-000000"
NEXT_PUBLIC_SUPPORT_HOTLINE="+880 1700-000000"
