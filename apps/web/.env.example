# Jawata Mart - Server Environment Variables Template
# Copy to .env.local on your server and populate with production values.
# NEVER commit production secret values to version control.

# Database
DATABASE_URL=

# Admin Authentication
JWT_SECRET=

# Payment Gateways (Server-side Secrets)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# Analytics & Meta Tracking (Server-side Secrets)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
GA4_MEASUREMENT_ID=
GTM_ID=
